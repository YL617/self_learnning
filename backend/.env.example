APP_ENV=prod
DEBUG=false
SECRET_KEY=please-change-me

# 开发默认 SQLite；生产切换为 MySQL
DATABASE_URL=sqlite:///./ai_study_dev.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_study?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
MYSQL_ROOT_PASSWORD=ai_study_root
MYSQL_PASSWORD=ai_study_pass

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI 模型配置
AI_PROVIDER=deepseek
AI_LOW_BALANCE_THRESHOLD=10
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# 管理员初始化：启动时将该邮箱用户设为 admin
ADMIN_INITIAL_EMAIL=

# 商业配置
TRIAL_DAYS=7
FREE_DAILY_AI_QUOTA=20
BASIC_DAILY_AI_QUOTA=60
ADVANCED_DAILY_AI_QUOTA=120
FULL_DAILY_AI_QUOTA=300
